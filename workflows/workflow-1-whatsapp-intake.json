    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\n\nconst from = (input.From || '').trim();\nconst body = (input.Body || '').trim();\nconst waId = (input.WaId || from.replace('whatsapp:', '')).trim();\nconst profileName = (input.ProfileName || 'Unknown').trim();\nconst messageSid = (input.MessageSid || '').trim();\n\nif (!from || !body) {\n  throw new Error(\n    `Invalid WhatsApp webhook payload — missing From or Body. Received keys: ${Object.keys(input).join(', ')}`\n  );\n}\n\nif (input.MessageStatus && !body) {\n  throw new Error('Status callback received on inbound-message webhook — check Twilio config');\n}\n\nreturn {\n  json: {\n    from,\n    body,\n    waId,\n    profileName,\n    messageSid,\n  }\n};"
      },
